# 统一换行：仓库里一律 LF，否则 GitHub runner 上的 bash 会因 CRLF 报错
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.gradle  text eol=lf
*.properties text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
gradlew   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 专用脚本保持 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制
*.jar     binary
*.png     binary
*.apk     binary
*.mp4     binary
